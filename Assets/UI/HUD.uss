/* HUD Styles */

.hud-container {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Allow touches to pass through to the game */
}

.turn-status-label {
    position: absolute;
    top: 20px;
    left: 5%;
    right: 5%;
    -unity-text-align: upper-center;
    font-size: 24px;
    font-weight: bold;
    color: white;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 1); /* Reduced intensity from 0.8 to 0.4 */
    pointer-events: none;
    white-space: nowrap;
}

.button-row {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    width: 100%;
    height: 50px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 15px;
    pointer-events: auto; /* Enable button interactions */
}

.hud-button {
    width: 60px;
    height: 40px;
    border-radius: 10px;
    background-color: rgba(100, 100, 100, 0.8);
    border-width: 2px;
    border-color: rgba(200, 200, 200, 0.9);
    border-style: solid;
    color: white;
    font-size: 14px;
    font-weight: bold;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
    flex-shrink: 0; /* Prevent buttons from shrinking */
}

.hud-button:hover {
    background-color: rgba(120, 120, 120, 0.9);
    border-color: rgba(220, 220, 220, 1.0);
}

.hud-button:active {
    background-color: rgba(80, 80, 80, 0.9);
    border-color: rgba(180, 180, 180, 1.0);
}

.left-button {
    display: flex;
    justify-content: center;
    align-items: center;
}

.move-button {
    /* Center button with MOVE text */
    width: 80px; /* Slightly wider for text */
}

.right-button {
    display: flex;
    justify-content: center;
    align-items: center;
}

#leftArrow {
    width: 48px;
    height: 48px;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
    background-image: url("project://database/Assets/Images/left-arrow.png?fileID=2800000&guid=192c82abf9cb32547b8dee39141f25eb&type=3#left-arrow");
}

#rightArrow {
    width: 48px;
    height: 48px;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
    background-image: url("project://database/Assets/Images/right-arrow.png?fileID=2800000&guid=dd2301e813869a84581a373d486fe451&type=3#right-arrow");
}

#test {
    flex-grow: 1;
    position: absolute;
    flex-direction: row;
    left: 0;
    top: 0;
    right: 90%;
    bottom: 90%;
}